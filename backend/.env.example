# Copy to backend/.env and fill in real values. Never commit backend/.env.
# Docker Compose passes this file to both the db and api services; the api
# builds its database URL from the POSTGRES_* values (host "db", port 5432).
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel
# Required, at least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# or: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Optional: MJPEG stream relayed by GET /camera/stream. The USB webcam of the Pi, served by the
# "webcam" compose service: http://webcam:8080/stream — or an ESP32 camera: http://<ip>:81/stream.
# Leave empty to disable the relay (the endpoint then answers 503).
CAMERA_STREAM_URL=http://webcam:8080/stream

# Person detection (YOLOv8n) on the camera stream: "is anyone there?".
# Requires the backend's "vision" extra (uv sync --extra vision) and a configured camera.
VISION_ENABLED=false
VISION_INTERVAL_SECONDS=1.0
# Also identify each detected person against the known-faces whitelist: "who is it?".
# Heavier (pulls in DeepFace/TensorFlow): requires the "vision-identify" extra
# (uv sync --extra vision-identify) instead of "vision", and has no effect if VISION_ENABLED
# is false.
VISION_IDENTIFY_FACES=false
VISION_KNOWN_FACES_DIR=data/known_faces
# Optional: shared key the ESP32 sends as X-Device-Key on POST /sensors/readings (16+ chars).
DEVICE_API_KEY=
# Optional: MQTT broker the ESP32 publish to (compose service "mosquitto"). Unset → no subscriber.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=sentinel/+
# Optional: host health shown on the dashboard. /proc inside Docker already describes the host;
# compose.yml mounts the thermal zone and a file of the root partition (any path of it works for
# statvfs) and points these at the mounts. Defaults shown.
HOST_PROC_PATH=/proc
HOST_THERMAL_PATH=/sys/class/thermal
HOST_DISK_PATH=/
SERVER_HEALTH_INTERVAL_S=5
SERVER_HEALTH_ENABLED=true
# Optional: sensor alert bounds, the same for every device (defaults shown). A reading outside
# opens an alert; it closes itself once the value is back inside with a small margin.
ALERT_TEMPERATURE_MIN_C=10
ALERT_TEMPERATURE_MAX_C=30
ALERT_HUMIDITY_MIN_PCT=20
ALERT_HUMIDITY_MAX_PCT=70
# Gas level (mV) above which an alert opens; empty → only the ESP's own "alerte" state counts.
ALERT_GAS_MAX_MV=
# Optional: siren. The ESP32 buzzer follows a retained MQTT state on this topic; triggers are
# "metric" or "metric:low|high", comma-separated; a mute from the front lasts this many minutes.
MQTT_BUZZER_TOPIC=sentinel/cmd/buzzer
BUZZER_TRIGGERS=gas,temperature:high
BUZZER_MUTE_MINUTES=15
