# Copy to backend/.env and fill in real values. Never commit backend/.env.
# Docker Compose passes this file to both the db and api services; the api
# builds its database URL from the POSTGRES_* values (host "db", port 5432).
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel
# Required, at least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# or: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Optional: MJPEG stream of the ESP32 camera, relayed by GET /camera/stream.
# Leave empty to disable the relay (the endpoint then answers 503).
CAMERA_STREAM_URL=
# Optional: shared key the ESP32 sends as X-Device-Key on POST /sensors/readings (16+ chars).
DEVICE_API_KEY=
# Optional: MQTT broker the ESP32 publish to (compose service "mosquitto"). Unset → no subscriber.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=sentinel/+
# Optional: sensor alert bounds, the same for every device (defaults shown). A reading outside
# opens an alert; it closes itself once the value is back inside with a small margin.
ALERT_TEMPERATURE_MIN_C=10
ALERT_TEMPERATURE_MAX_C=30
ALERT_HUMIDITY_MIN_PCT=20
ALERT_HUMIDITY_MAX_PCT=70
# Gas level (mV) above which an alert opens; empty → only the ESP's own "alerte" state counts.
ALERT_GAS_MAX_MV=
