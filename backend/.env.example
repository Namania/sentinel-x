# Copy to backend/.env and fill in real values. Never commit backend/.env.
# Docker Compose passes this file to both the db and api services; the api
# builds its database URL from the POSTGRES_* values (host "db", port 5432).
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel
# Required, at least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# or: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Optional: MJPEG stream of the ESP32 camera, relayed by GET /camera/stream.
# Leave empty to disable the relay (the endpoint then answers 503).
CAMERA_STREAM_URL=http://192.168.1.50:81/stream
